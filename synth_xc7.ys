# Top module: cnn_top
# Target: Xilinx Artix-7 (Nexys A7-100T xc7a100tcsg324-1)

read_verilog rtl/cnn/conv_5x5.v
read_verilog rtl/cnn/relu.v
read_verilog rtl/cnn/max_pool_2x2.v
read_verilog rtl/cnn/bram_weights.v

read_verilog rtl/cnn/conv1_weight_mem.v
read_verilog rtl/cnn/conv1_bias_mem.v
read_verilog rtl/cnn/conv2_weight_mem.v
read_verilog rtl/cnn/conv2_bias_mem.v
read_verilog rtl/cnn/fc1_weight_mem.v
read_verilog rtl/cnn/fc1_bias_mem.v
read_verilog rtl/cnn/fc2_weight_mem.v
read_verilog rtl/cnn/fc2_bias_mem.v
read_verilog rtl/cnn/fc3_weight_mem.v
read_verilog rtl/cnn/fc3_bias_mem.v

read_verilog rtl/cnn/conv_layer_1.v
read_verilog rtl/cnn/conv_layer_2.v
read_verilog rtl/cnn/pool_layer_1.v
read_verilog rtl/cnn/pool_layer_2.v
read_verilog rtl/cnn/flatten.v
read_verilog rtl/cnn/fc_layer_1.v
read_verilog rtl/cnn/fc_layer_2.v
read_verilog rtl/cnn/fc_layer_3.v
read_verilog rtl/cnn/fc_layers.v

read_verilog -sv rtl/cnn/cnn_top.sv

hierarchy -check -top cnn_top

synth_xilinx -family xc7 -top cnn_top -flatten

write_verilog synth_cnn_top_xc7a100t.v

stat -tech xilinx
